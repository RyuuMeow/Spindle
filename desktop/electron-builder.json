{
  "appId": "com.yarnworkbench.desktop",
  "productName": "Spindle",
  "fileAssociations": [
    {
      "ext": "yarn",
      "name": "Yarn \u5287\u672c",
      "role": "Editor"
    }
  ],
  "directories": {
    "app": "dist-desktop/app",
    "output": "release"
  },
  "files": [
    "desktop/main.cjs",
    "desktop/i18n.cjs",
    "desktop/preload.cjs",
    "desktop/workspace-service.cjs",
    "dist-desktop/renderer/**/*",
    "package.json",
    "!node_modules/**/*",
    "desktop/icon.png",
    "desktop/window-lifecycle.cjs",
    "desktop/mcp-windows.cjs",
    "desktop/mcp-runtime.cjs",
    "desktop/system-fonts.cjs",
    "licenses/**/*",
    "skills/spindle/**/*",
    "desktop/restart.cjs",
    "desktop/update-service.cjs",
    "desktop/portable-update.ps1",
    "desktop/installed-restart.ps1"
  ],
  "asar": true,
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "desktop/icon.ico"
  },
  "nsis": {
    "useZip": true,
    "differentialPackage": false,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "artifactName": "Spindle-${version}-Setup-${arch}.${ext}"
  },
  "portable": {
    "unpackDirName": true,
    "useZip": true,
    "splashImage": "desktop/portable-splash.bmp",
    "artifactName": "Spindle-${version}-Portable-${arch}.${ext}"
  },
  "npmRebuild": false,
  "publish": [
    {
      "provider": "github",
      "owner": "RyuuMeow",
      "repo": "Spindle",
      "releaseType": "draft"
    }
  ]
}
