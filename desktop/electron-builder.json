{
  "appId": "com.yarnworkbench.desktop",
  "productName": "Spindle",
  "fileAssociations": [
    {
      "ext": "yarn",
      "name": "Yarn 劇本",
      "role": "Editor"
    }
  ],
  "directories": {
    "app": "dist-desktop/app",
    "output": "release"
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/workspace-service.cjs",
    "dist-desktop/renderer/**/*",
    "package.json",
    "!node_modules/**/*",
    "desktop/icon.png"
  ],
  "asar": true,
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "desktop/icon.ico"
  },
  "nsis": {
    "useZip": true,
    "differentialPackage": false,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "artifactName": "Spindle-${version}-Setup-${arch}.${ext}"
  },
  "portable": {
    "unpackDirName": true,
    "useZip": true,
    "splashImage": "desktop/portable-splash.bmp",
    "artifactName": "Spindle-${version}-Portable-${arch}.${ext}"
  },
  "npmRebuild": false
}
